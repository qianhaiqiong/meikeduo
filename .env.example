# Mercado Libre application credentials from Global Selling Dev Center
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://your-domain.com/meli/oauth/callback

# Required in production. Use a long random string.
ADMIN_TOKEN=change-this-to-a-long-random-value
TOKEN_ENCRYPTION_KEY=change-this-to-another-long-random-value

# Optional: change only if Mercado Libre documentation asks you to.
MELI_AUTH_BASE_URL=https://global-selling.mercadolibre.com
MELI_API_BASE_URL=https://api.mercadolibre.com
